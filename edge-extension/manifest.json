{
  "manifest_version": 3,
  "name": "Job Hunt Extractor",
  "version": "1.0.0",
  "description": "Extract the current job posting into Job Hunt Agent JSON.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_title": "Job Hunt Extractor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
